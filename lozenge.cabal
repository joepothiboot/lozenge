cabal-version: 3.0
name:          lozenge
version:       0.1.0.0
license:       MIT
license-file:  LICENSE
author:        Watcharapong Joe Pothiboot
build-type:    Simple

common warnings
  ghc-options: -Wall

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:
    Lozenge.Cli
    Lozenge.Critical
    Lozenge.EGraph
    Lozenge.EMatch
    Lozenge.EmitC
    Lozenge.Eval
    Lozenge.EvalT
    Lozenge.Expr
    Lozenge.ExprF
    Lozenge.Extract
    Lozenge.Fix
    Lozenge.Fusion
    Lozenge.Grad
    Lozenge.Graph
    Lozenge.Json
    Lozenge.Mlp
    Lozenge.Parse
    Lozenge.Pretty
    Lozenge.Rule
    Lozenge.Rewrite
    Lozenge.RuleParse
    Lozenge.Saturate
    Lozenge.Smt
    Lozenge.SymExec
    Lozenge.Tensor
    Lozenge.TensorEval
    Lozenge.TensorOpt
    Lozenge.Solver
    Lozenge.Typecheck
    Lozenge.Typed
    Lozenge.UnionFind
    Lozenge.VerifyBrute
    Lozenge.VerifySmt
  build-depends:
    , aeson
    , array
    , base
    , containers
    , directory
    , megaparsec
    , mtl
    , prettyprinter
    , process
    , text
  default-language: GHC2021

executable lozenge
  import:           warnings
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:
    , base
    , lozenge
    , optparse-applicative
    , text
  default-language: GHC2021

executable lozenge-demo
  import:           warnings
  hs-source-dirs:   app
  main-is:          Demo.hs
  build-depends:
    , base
    , lozenge
    , megaparsec
    , QuickCheck
    , tasty-bench
    , text
  default-language: GHC2021

executable lozenge-train
  import:           warnings
  hs-source-dirs:   app
  main-is:          Train.hs
  build-depends:
    , base
    , directory
    , lozenge
    , text
  default-language: GHC2021

test-suite spec
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:
    CHarness
    ExprGen
    Golden
    Lozenge.CliSpec
    Lozenge.CorpusSpec
    Lozenge.CriticalSpec
    Lozenge.EGraphSpec
    Lozenge.EdgeSpec
    Lozenge.EmitCSpec
    Lozenge.EvalSpec
    Lozenge.EvalTSpec
    Lozenge.ExprFSpec
    Lozenge.ExprSpec
    Lozenge.FusionSpec
    Lozenge.GradSpec
    Lozenge.GraphSpec
    Lozenge.MlpSpec
    Lozenge.ParseSpec
    Lozenge.PrettySpec
    Lozenge.RewriteSpec
    Lozenge.RuleParseSpec
    Lozenge.RuleSpec
    Lozenge.SaturateSpec
    Lozenge.SmtSpec
    Lozenge.SymExecSpec
    Lozenge.SolverSpec
    Lozenge.TypecheckSpec
    Lozenge.TensorOptSpec
    Lozenge.TensorSpec
    Lozenge.TypedSpec
    Lozenge.UnionFindSpec
    Lozenge.VerifyBruteSpec
    Lozenge.VerifySmtSpec
    Props
    TensorPrograms
    TExprGen
    Z3
  build-depends:
    , aeson
    , base
    , bytestring
    , containers
    , directory
    , lozenge
    , megaparsec
    , mtl
    , process
    , QuickCheck
    , tasty
    , tasty-golden
    , tasty-hunit
    , tasty-quickcheck
    , text
  default-language: GHC2021
