cabal-version: 3.0
name:          lozenge
version:       0.1.0.0
license:       MIT
license-file:  LICENSE
author:        Watcharapong Joe Pothiboot
build-type:    Simple

common warnings
  ghc-options: -Wall

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:
    Lozenge.Eval
    Lozenge.EvalT
    Lozenge.Expr
    Lozenge.Parse
    Lozenge.Pretty
    Lozenge.Rule
    Lozenge.RuleParse
    Lozenge.Smt
    Lozenge.Solver
    Lozenge.Typecheck
    Lozenge.Typed
    Lozenge.VerifyBrute
  build-depends:
    , base
    , containers
    , directory
    , megaparsec
    , prettyprinter
    , process
    , text
  default-language: GHC2021

executable lozenge
  import:           warnings
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:    base
  default-language: GHC2021

test-suite spec
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:
    ExprGen
    Golden
    Lozenge.CorpusSpec
    Lozenge.EdgeSpec
    Lozenge.EvalSpec
    Lozenge.EvalTSpec
    Lozenge.ExprSpec
    Lozenge.ParseSpec
    Lozenge.PrettySpec
    Lozenge.RuleParseSpec
    Lozenge.RuleSpec
    Lozenge.SmtSpec
    Lozenge.SolverSpec
    Lozenge.TypecheckSpec
    Lozenge.TypedSpec
    Lozenge.VerifyBruteSpec
    Props
    TExprGen
    Z3
  build-depends:
    , base
    , bytestring
    , containers
    , directory
    , lozenge
    , megaparsec
    , process
    , tasty
    , tasty-golden
    , tasty-hunit
    , tasty-quickcheck
    , text
  default-language: GHC2021
